{
    "name": "nova-ai/mcp-tools",
    "description": "Exposes Laravel Nova dashboards, resources, lenses, actions and notifications as MCP tools.",
    "keywords": [
        "laravel",
        "nova",
        "mcp"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "David Hemphill",
            "email": "hemp@hey.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "laravel/mcp": "^0.9"
    },
    "require-dev": {
        "laravel/nova": "^5.0",
        "laravel/nova-devtool": "^1.7"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "NovaAi\\McpTools\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NovaAi\\McpTools\\ToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
