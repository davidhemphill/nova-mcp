{
    "name": "hemp/nova-mcp",
    "description": "Exposes Laravel Nova dashboards, resources, lenses, actions and notifications as MCP tools.",
    "keywords": [
        "laravel",
        "nova",
        "mcp"
    ],
    "homepage": "https://github.com/davidhemphill/nova-mcp",
    "support": {
        "issues": "https://github.com/davidhemphill/nova-mcp/issues",
        "source": "https://github.com/davidhemphill/nova-mcp"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "David Hemphill",
            "email": "hemp@hey.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "laravel/mcp": "^1.0",
        "laravel/nova": "^5.0"
    },
    "require-dev": {
        "laravel/ai": "^1.2",
        "laravel/nova-devtool": "^1.7",
        "laravel/pint": "^1.24",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^12.5"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://nova.laravel.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Hemp\\NovaMcp\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Hemp\\NovaMcp\\ToolServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "prefer-stable": true,
    "autoload-dev": {
        "psr-4": {
            "Hemp\\NovaMcp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint"
    }
}
